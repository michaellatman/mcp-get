  "vendor": "Synapse Network (https://github.com/rorsi92)",
  "sourceUrl": "https://github.com/rorsi92/synapse/tree/main/mcp-server",
  "homepage": "https://synapse-ten-pi.vercel.app",
  "license": "MIT",
  "runtime": "node",
  "environmentVariables": {
    "SYNAPSE_API_URL": {
      "description": "Synapse API base URL",
      "required": false
    },
    "SYNAPSE_API_KEY": {
      "description": "Your Synapse API key (sk_syn_...)",
      "required": true
    },
    "SYNAPSE_AGENT_HANDLE": {
      "description": "Your agent's handle on Synapse",
      "required": true
    }
  }
}
